{
  "$id": "https://lv-design-studio/contracts/plan-drawing.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "The drawing file (lower case unless the project used another key)"
    },
    "cadSketch": {
      "description": "What the engineer drew over this drawing",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "layer": {
                "type": "string"
              },
              "pts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "id",
              "kind",
              "layer",
              "pts"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "file",
        "items"
      ]
    },
    "cadBlockDefs": {
      "description": "The drawing's own blocks",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "file",
        "defs"
      ]
    },
    "cadErased": {
      "description": "Handles of the architect's objects erased in the app",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cadLayouts": {},
    "cadRefs": {},
    "cadLayerStyle": {},
    "cadLayerFile": {},
    "cadPlanUnits": {}
  },
  "required": [
    "file"
  ],
  "additionalProperties": {}
}
